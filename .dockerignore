# Keep the build context small — the venv and node_modules are ~1GB.
.git
.github
**/.venv
**/venv
**/node_modules
**/__pycache__
**/*.pyc
frontend/dist

# Secrets are injected at runtime via env_file, never baked into a layer.
**/.env
**/.env.*

# Data and eval artifacts — not needed to serve the API.
backend/app/resources
backend/load_test_results
web-scrapping
*.ipynb

# Local-only notes and generated output
upgrade-roadmap.txt
migrations.sql
CLAUDE.md
.claude
human_eval*.json
evaluation_*.json
*.md
!README.md
