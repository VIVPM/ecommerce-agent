{
  "title": "E-commerce Agent — Overview",
  "uid": "ecommerce-agent-overview",
  "tags": ["ecommerce-agent"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "grafanacloud-prom", "value": "grafanacloud-prom" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Message rate by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(chat_messages_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Success rate (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(chat_messages_total{status=\"ok\"}[1h])) / clamp_min(sum(increase(chat_messages_total[1h])), 1)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(chat_messages_total{status=\"error\"}[1h]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Messages by tool (1h)",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "options": { "legend": { "showLegend": true, "placement": "right" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (increase(chat_messages_total[1h]))",
          "legendFormat": "{{tool}}",
          "instant": true
        }
      ]
    }
  ]
}
